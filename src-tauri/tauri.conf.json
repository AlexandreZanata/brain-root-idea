{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrainRoot",
  "identifier": "dev.brainroot.experiment",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BrainRoot",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/brainroot/LICENSE": "../LICENSE",
          "/usr/share/doc/brainroot/NOTICE": "../NOTICE"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
